#!/usr/bin/env perl
# Sync the package version across every manifest that carries one.
#
# `--check` verifies they already agree (and match a version, if given) without
# writing anything — that's the mode CI runs, so a half-applied bump can't reach
# a tag. `--check --release` also requires a `## v<version>` section in
# CHANGELOG.md; release.yml runs it before it tags, since that section becomes
# the release notes.

use v5.20;
use warnings;

# Core-only file IO: this script is a CI guard, so it must run on a bare perl
# with nothing installed.
sub slurp {
    my ($path) = @_;
    open my $fh, '<:encoding(UTF-8)', $path or die "open $path: $!\n";
    local $/;
    return <$fh>;
}

sub spew {
    my ($path, $content) = @_;
    open my $fh, '>:encoding(UTF-8)', $path or die "open $path: $!\n";
    print {$fh} $content;
    close $fh or die "close $path: $!\n";
}

# Keep this list exhaustive. A missing entry drifts silently: tree-sitter.json
# was absent here and sat at 1.0.0 through every release up to 1.2.1 before
# anyone noticed, and package-lock.json sat at 1.0.0 until 2.0.5. Each
# pattern's first match carries the version in its capture group, and a bump
# rewrites only that group.
my @files = (
    { file => 'package.json',      pattern => qr/"version":\s*"([^"]*)"/ },
    { file => 'Cargo.toml',        pattern => qr/^version\s*=\s*"([^"]*)"/m },
    { file => 'pyproject.toml',    pattern => qr/^version\s*=\s*"([^"]*)"/m },
    # metadata.version — the only "version" key in the file.
    { file => 'tree-sitter.json',  pattern => qr/"version":\s*"([^"]*)"/ },
    # The lockfile names the root package twice: at the top, and again as
    # packages[""]. Its dependencies' versions sit deeper in that object.
    {
        file    => 'package-lock.json',
        where   => 'root',
        pattern => qr/\A\{\s*"name":\s*"tree-sitter-perl",\s*"version":\s*"([^"]*)"/,
    },
    {
        file    => 'package-lock.json',
        where   => 'packages[""]',
        pattern => qr/"":\s*\{\s*"name":\s*"tree-sitter-perl",\s*"version":\s*"([^"]*)"/,
    },
);
$_->{label} = join ' ', grep defined, @$_{qw(file where)} for @files;

my ($check, $release) = (0, 0);
my @args;
for (@ARGV) {
    if    ($_ eq '--check')   { $check = 1 }
    elsif ($_ eq '--release') { $release = 1 }
    else                      { push @args, $_ }
}
my $version = shift @args;

die "Usage: $0 <version>      e.g. $0 2.0.0\n" .
    "       $0 --check [--release] [<version>]\n"
    unless $check || defined $version;
die "--release only goes with --check\n" if $release && !$check;

die "Version must be semver (e.g. 2.0.0), got: $version\n"
    if defined $version && $version !~ /^\d+\.\d+\.\d+$/;

# Read what each file currently claims.
my %found;
for my $spec (@files) {
    my $content = slurp($spec->{file});
    my ($current) = $content =~ $spec->{pattern};
    die "Failed to find a version in $spec->{label}\n" unless defined $current;
    $found{ $spec->{label} } = $current;
}

if ($check) {
    my %distinct = map { $_ => 1 } values %found;
    my @versions = keys %distinct;

    my $ok = 1;
    if (@versions > 1) {
        say STDERR "Version mismatch across manifests:";
        $ok = 0;
    }
    elsif (defined $version && $versions[0] ne $version) {
        say STDERR "Manifests are at $versions[0], expected $version:";
        $ok = 0;
    }

    unless ($ok) {
        printf STDERR "  %-30s %s\n", $_->{label}, $found{ $_->{label} } for @files;
        say STDERR "\nRun: script/bump-version <version>";
        exit 1;
    }

    if ($release && slurp('CHANGELOG.md') !~ /^## v\Q$versions[0]\E(?:\s|$)/m) {
        say STDERR "CHANGELOG.md has no '## v$versions[0]' section; it becomes the release notes.";
        exit 1;
    }

    say "All manifests at $versions[0]:";
    printf "  %-30s %s\n", $_->{label}, $found{ $_->{label} } for @files;
    exit 0;
}

for my $spec (@files) {
    my $content = slurp($spec->{file});
    die "Failed to find a version in $spec->{label}\n" unless $content =~ $spec->{pattern};
    substr($content, $-[1], $+[1] - $-[1]) = $version;

    spew($spec->{file}, $content);
    say "Updated $spec->{label}  $found{$spec->{label}} -> $version";
}

say <<~"END";

    Done. To release:
      add a '## v$version — <date>' section to CHANGELOG.md (the release notes)
      commit the bump with it and merge to master; release.yml tags v$version
      and publishes
    END
